{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campuscarbon-cf",
  "main": "src/index.js",
  "compatibility_date": "2026-08-14",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
